    "revision": "87f09149ef4734204d70ed1d046ddc9ca3f2b8f9",
    "tokenizer": "gpt2",
    "note": "Read the already-prepared frozen corpus from a separate data work directory. Benchmark outputs must use a new work directory."
  },
  "model": {
    "vocab_size": 50257,
    "block_size": 512,
    "n_layer": 12,
    "n_head": 12,
    "n_kv_head": 12,
    "n_embd": 768,
    "mlp_hidden": 2048,
    "dropout": 0,
    "bias": false,
    "rope_base": 10000,
    "rope_mode": "fixed",
    "qk_norm": false,
    "stats_beta": 0.95,
    "moe_experts": 0,
    "gradient_checkpointing": false,
    "batch_size": 4,
    "grad_accum": 2
  },
  "optimizer_shared": {
    "momentum": 0.95,
    "ns_steps": 5,
    "functional_power": 1,
    "metric_eps": 0.00001,
    "metric_condition_cap": 100,
    "moonshot_rms_scale": 0.2,
    "qk_clip_threshold": 100
  },
  "schedule": {
    "warmup_ratio": 0.05,
    "decay": "cosine_to_10_percent",
    "note": "All optimizer families use the same benchmark schedule so the comparison isolates optimizer mechanics rather than reproducing each lab's full training recipe."
  },
  "optimizers": {
    "orbit_all": {
      "provenance": {
        "lab": "ORBIT-all",
        "models": [
          "ORBIT-all dense 124M-class research harness"
        ],
        "algorithm": "function-aware Muon extension",
        "source": "https://github.com/pop123-ux/ORBIT-all",
        "note": "Frozen to the pre-existing shared-03 recipe; not retuned after production-baseline selection."
      }
    },
    "muon_moonlight": {
      "provenance": {
        "lab": "Moonshot AI",
        "models": [
          "Moonlight-16B-A3B"
        ],
        "algorithm": "Muon with weight decay and consistent Adam-RMS matching",
        "source": "https://github.com/MoonshotAI/Moonlight",
        "note": "Same-harness implementation of disclosed Moonlight Muon mechanics: Nesterov momentum candidate, Newton-Schulz, weight decay, and 0.2*sqrt(max(m,n)) update-RMS scaling. v1 uses the same base LR for the matrix and auxiliary Adam-style paths in the tuning grid, matching the public Moonlight toy implementation more closely; this is still not a reproduction of Moonlight's MoE architecture or full recipe."
      }
    },
    "muonclip_kimi": {
      "provenance": {
        "lab": "Kimi Team / Moonshot AI",
        "models": [
          "Kimi K2"
        ],
        "algorithm": "MuonClip",
        "source": "https://arxiv.org/abs/2507.20534",
        "note": "Regular-MHA adaptation of Kimi K2 QK-Clip with tau=100 on top of the corrected Moonshot-style Nesterov/RMS-scaled Muon base. Kimi K2 itself uses MLA; this benchmark does not claim exact K2 recipe reproduction."
      }
    },
    "adamw": {
      "provenance": {
        "lab": "Alibaba Qwen; DeepSeek; widely used elsewhere",
        "models": [
          "Qwen-7B",
          "DeepSeek LLM 7B/67B"
        ],
        "algorithm": "AdamW",
        "sources": [
          "https://github.com/QwenLM/Qwen/blob/main/tech_memo.md",
          "https://arxiv.org/abs/2401.02954"
        ],
        "note": "One algorithm baseline rather than duplicate lab-branded AdamW variants; learning rate and decay are tuned in the common harness."
      }
    },
    "lion": {
      "provenance": {
        "lab": "MosaicML / Databricks",
        "models": [
          "MPT-7B"
        ],
        "algorithm": "Lion",
        "source": "https://www.databricks.com/blog/mpt-7b",
        "note": "MPT-7B's training write-up explicitly reports Lion instead of AdamW."
      }
    },
    "adafactor_palm": {
      "provenance": {
        "lab": "Google Research",
        "models": [
          "PaLM 8B/62B/540B"
        ],
        "algorithm": "unfactorized Adafactor with parameter scaling",
        "source": "https://arxiv.org/abs/2204.02311",
        "note": "Keeps PaLM's unfactorized second moment, beta1=0.9, beta2=1-k^-0.8 and parameter-RMS scaling, but uses the common benchmark schedule."
      }
    },
    "adam": {
      "provenance": {
        "lab": "EleutherAI",
        "models": [
          "GPT-NeoX-20B"
        ],
        "algorithm": "Adam",
        "source": "https://github.com/EleutherAI/gpt-neox/blob/main/configs/20B.yml",
        "note": "Uses beta1=0.9, beta2=0.95 and eps=1e-8, with learning rate and decay tuned in the common harness."
      }
    }
  },
