  "statistics": {
    "estimand": "paired final validation loss difference ORBIT-all minus each production optimizer on held-out seeds",
    "interval": "two-sided 95% Student-t confidence interval over paired seed differences",
    "secondary": [
      "win counts",
      "wall-clock time",
      "peak allocated CUDA memory"
    ],
    "multiplicity": "post-confirmation secondary benchmark; report all comparisons transparently rather than treating p-values as a new preregistered family"
  },
  "interpretation": {
    "scope": "same-model, same-data, same-budget optimizer-algorithm benchmark",
    "not_claimed": "This is not an exact reproduction of any lab's full model architecture, batch schedule, data mixture, distributed system, or training recipe.",
    "fairness": "v1 is a pre-confirmation repair of the production baseline benchmark after inspecting tuning seed 900 only. ORBIT-all remains conservatively frozen to the earlier shared-03 recipe. Each production baseline receives nine predeclared candidates; no held-out seeds 910-919 were inspected before freezing v1."
  },
  "pilot_history": {
    "v0_git_sha": "e702df7535b75d29c6e024bda7965bd6a0234f73",
    "v0_outcome": "tuning-only pilot on seed 900; no seeds 910-919 were evaluated",
    "reason_for_v1": [
      "Moonlight/Kimi RMS-scaled Muon used an inappropriately high base-LR grid",
      "Moonshot-style Muon candidate needed the recommended Nesterov look-ahead before Newton-Schulz",
      "PaLM Adafactor selected the upper LR boundary",
      "Adam LR and weight decay were too entangled to identify the cause of its boundary winner"
    ],
    "integrity_rule": "ORBIT-all remains frozen to shared-03 and receives no tuning benefit from the pilot."
  }
